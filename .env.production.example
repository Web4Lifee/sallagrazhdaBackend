# For the server. Copy to .env next to docker-compose.prod.yml and fill in EVERY value.
# Never commit the real file (git ignores .env).

# Domain that points at this server (DNS A/AAAA record) and an email for Let's Encrypt notices.
DOMAIN=api.example.com
ACME_EMAIL=you@example.com

POSTGRES_DB=sallagrazhda
POSTGRES_USER=sallagrazhda
# Generate a strong password with:  openssl rand -hex 32
# (hex = letters and digits only, so it is safe inside the database URL). The API refuses to start with CHANGE_ME.
POSTGRES_PASSWORD=CHANGE_ME

# Time zone for season start dates (the 1st of the start month at midnight).
TZ=Europe/Tirane

# Comma-separated https:// origins, only if a web build of the app calls the API from a browser.
CORS_ORIGINS=

LOG_LEVEL=info
SESSION_TTL_DAYS=30
BACKUP_KEEP_DAYS=14
