# For running the API on your own machine with `npm run dev`.
# Copy to .env (which git ignores). Start the database first: docker compose up -d db

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true
TZ=Europe/Tirane

# Matches the local database in docker-compose.yml (local only, never use this password on a server).
DATABASE_URL=postgres://sallagrazhda:localdev@localhost:5432/sallagrazhda
# Used by `npm test`; created automatically by scripts/init-test-db.sql.
TEST_DATABASE_URL=postgres://sallagrazhda:localdev@localhost:5432/sallagrazhda_test

# Only needed for https:// web origins; in development http://localhost on any port is already allowed.
CORS_ORIGINS=

# docker compose only: set to 0.0.0.0 to reach the local API from a phone on the same Wi-Fi.
# API_BIND=0.0.0.0
